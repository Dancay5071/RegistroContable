rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidPositiveAmount(val) {
      return val is number && val > 0;
    }

    function isValidNonNegativeAmount(val) {
      return val is number && val >= 0;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidMonth(m) {
      return m in [
        'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
        'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
      ];
    }

    function isValidYear(y) {
      return y is number && y >= 2000 && y <= 2100;
    }

    function isValidCurrency(c) {
      return c in ['ARS', 'USD', 'EUR'];
    }

    function isValidTransactionType(t) {
      return t in ['gasto', 'ingreso', 'ahorro', 'extraccion'];
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /config/balances {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (!('montoActual' in request.resource.data) || request.resource.data.montoActual is number)
          && (!('totalAhorros' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.totalAhorros))
          && (!('totalAhorrosUSD' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.totalAhorrosUSD))
          && (!('totalAhorrosEUR' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.totalAhorrosEUR));
        allow delete: if false;
      }

      match /transacciones/{transaccionId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && isValidTransactionType(request.resource.data.tipo)
          && isValidPositiveAmount(request.resource.data.monto)
          && isValidString(request.resource.data.descripcion, 1, 150)
          && isValidMonth(request.resource.data.mes)
          && isValidYear(request.resource.data.anio)
          && isValidString(request.resource.data.claveMesAnio, 6, 25)
          && (!('categoria' in request.resource.data) || isValidString(request.resource.data.categoria, 1, 60))
          && (!('moneda' in request.resource.data) || isValidCurrency(request.resource.data.moneda))
          && (!('porcentajeAhorro' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.porcentajeAhorro))
          && (!('montoBruto' in request.resource.data) || isValidPositiveAmount(request.resource.data.montoBruto))
          && (!('ahorro' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.ahorro))
          && (!('montoAhorro' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.montoAhorro));
      }

      match /resumenesMensuales/{mesAnio} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (!('totalGastos' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.totalGastos))
          && (!('totalIngresos' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.totalIngresos))
          && (!('totalAhorros' in request.resource.data) || isValidNonNegativeAmount(request.resource.data.totalAhorros));
      }

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: false;
    }
  }
}
