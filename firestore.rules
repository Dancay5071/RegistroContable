rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas multiusuario: cada usuario tiene acceso exclusivo a su rama
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Compatibilidad de transición con colecciones globales
    match /settings/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /setting/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /gastosPorMes/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ingresosPorMes/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ahorrosPorMes/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /extraccionPorMes/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /gastos/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ingresos/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /extaccion/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Denegar cualquier otra petición no explícita
    match /{document=**} {
      allow read, write: false;
    }
  }
}
